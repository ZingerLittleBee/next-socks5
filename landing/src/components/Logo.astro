---
// Brand mark: Lucide "plug-zap" stroked in the dark ink on the cyan brand chip.
interface Props {
  size?: number;
  icon?: number;
}
const { size = 26, icon = 15 } = Astro.props;
const radius = Math.round(size * 0.27);
---

<span class="logo" style={`width:${size}px; height:${size}px; border-radius:${radius}px;`}>
  <svg
    width={icon}
    height={icon}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M6.3 20.3a2.4 2.4 0 0 0 3.4 0L12 18l-6-6-2.3 2.3a2.4 2.4 0 0 0 0 3.4Z"></path>
    <path d="m2 22 3-3"></path>
    <path d="M7.5 13.5 10 11"></path>
    <path d="M10.5 16.5 13 14"></path>
    <path d="m18 3-4 4h6l-4 4"></path>
  </svg>
</span>

<style>
  .logo {
    display: inline-grid;
    flex: none;
    place-items: center;
    background: var(--cyan);
    color: var(--on-cyan);
  }
</style>
