---
import { INSTALL_CMD } from '../consts';

// The most-used flags only; `--help` lists the rest. Mirrors install.sh's
// usage() and the clap definitions in src/config.rs.
const groups = [
  {
    name: 'install.sh',
    note: 'sh -s -- [flags]',
    flags: [
      ['--method', 'binary|docker', 'service or compose', 'binary'],
      ['--port', '<port>', 'listen port', 'random free'],
      ['--user / --pass', '<v>', 'your own credentials', 'generated'],
      ['--udp-advertise', '<host>', 'public IP for UDP', 'bound addr'],
    ],
  },
  {
    name: 'next-socks5',
    note: 'override config.toml',
    flags: [
      ['--config', '<path>', 'TOML config file', 'none'],
      ['--listen', '<addr>', 'listen address', '127.0.0.1:1080'],
      ['--no-tui', '', 'headless, log to stdout', 'TUI on'],
      ['attach', '', 'dashboard of a running server', 'admin.sock'],
    ],
  },
];
---

<section id="install" class="section">
  <div class="section-head">
    <span class="section-key">5</span>
    <h2>Install</h2>
    <span class="section-rule"></span>
  </div>
  <p class="section-lede">
    Linux on x86_64 or aarch64. The installer generates a username and a 20-character password, picks a
    free port, and starts a systemd or OpenRC service.
  </p>

  <div class="section-body install">
    <div class="box box--focus">
      <span class="box-title">install.sh</span>
      <span class="box-meta">recommended</span>
      <div class="steps">
        <div class="dim"># binary + service, generated credentials, free port</div>
        <div class="cmd-row">
          <pre class="cmd"><span class="ps">$ </span>{INSTALL_CMD}</pre>
          <button class="copy" type="button" data-copy={INSTALL_CMD} aria-label="Copy install command">copy</button>
        </div>
        <div class="dim gap"># pass flags after -s --</div>
        <pre class="cmd"><span class="ps">$ </span>curl -fsSL .../install.sh | sh -s -- --method docker --port 1080</pre>
        <div class="dim gap"># test it with the credentials the installer prints</div>
        <pre class="cmd"><span class="ps">$ </span>curl --socks5 user_k7f2qa:••••@127.0.0.1:41873 https://api.ipify.org</pre>
        <div class="dim gap"># watch live traffic on the host</div>
        <pre class="cmd"><span class="ps">$ </span>next-socks5 attach</pre>
      </div>
    </div>

    <div class="box">
      <span class="box-title">flags</span>
      <span class="box-meta">--help for the rest</span>
      <div class="groups">
        {
          groups.map((g) => (
            <div class="group">
              <div class="group-head">
                {g.name}
                <span>{g.note}</span>
              </div>
              <table class="flags">
                <tbody>
                  {g.flags.map(([flag, arg, what, def]) => (
                    <tr>
                      <td>
                        <span class="flag">{flag}</span>
                        {arg && <span class="arg">{arg}</span>}
                      </td>
                      <td>{what}</td>
                      <td>{def}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .install {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-in);
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 13px;
  }
  .steps .gap {
    margin-top: 10px;
  }
  .cmd-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .cmd {
    flex: 1;
    margin: 0;
    color: var(--text);
    font: inherit;
    white-space: pre-wrap;
    word-break: break-all;
  }
  .copy {
    flex: none;
    height: 28px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: var(--r-ctl);
    background: transparent;
    color: var(--text);
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition:
      border-color 0.12s ease,
      color 0.12s ease;
  }
  .copy:hover {
    border-color: var(--cyan);
    color: var(--cyan);
  }

  .groups {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .group-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--text);
    font-size: 12.5px;
    font-weight: 600;
  }
  .group-head span {
    color: var(--dim);
    font-weight: 400;
  }

  .flags {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
    line-height: 1.5;
  }
  .flags td {
    padding: 6px 10px 6px 0;
    border-top: 1px solid var(--line2);
    color: var(--text2);
    vertical-align: baseline;
  }
  .flags td:first-child {
    width: 1%;
    white-space: nowrap;
  }
  .flags td:last-child {
    padding-right: 0;
    color: var(--dim);
    text-align: right;
    white-space: nowrap;
  }
  .flag {
    color: var(--cyan);
    font-weight: 600;
  }
  .arg {
    margin-left: 6px;
    color: var(--text2);
  }

  @media (max-width: 960px) {
    .install {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Stack each flag as name / description / default on phones. */
  @media (max-width: 560px) {
    .flags,
    .flags tbody,
    .flags tr,
    .flags td {
      display: block;
    }
    .flags tr {
      padding: 8px 0;
      border-top: 1px solid var(--line2);
    }
    .flags td,
    .flags td:first-child,
    .flags td:last-child {
      width: auto;
      padding: 0;
      border: 0;
      text-align: left;
    }
    .flags td:last-child::before {
      content: 'default: ';
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    let timer: ReturnType<typeof setTimeout> | undefined;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.textContent = 'copied';
      } catch {
        // Clipboard API unavailable (e.g. insecure context).
        btn.textContent = 'copy failed';
      }
      clearTimeout(timer);
      timer = setTimeout(() => (btn.textContent = 'copy'), 1600);
    });
  });
</script>
