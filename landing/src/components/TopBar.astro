---
import Logo from './Logo.astro';
import { REPO, SECTIONS, VERSION } from '../consts';
---

<header class="topbar" data-topbar data-repo={REPO}>
  <a class="brand" href="#overview" data-go="0">
    <Logo />
    <span class="brand-name">next-socks5</span>
    <span class="brand-ver">v{VERSION}</span>
  </a>
  <nav class="tabs" aria-label="Sections" data-tabs>
    {
      SECTIONS.map((s, i) => (
        <a class:list={['tab', { 'is-on': i === 0 }]} href={`#${s.id}`} data-go={i} data-tab={s.id}>
          <span class="tab-key">{i + 1}</span>
          {s.label}
        </a>
      ))
    }
  </nav>
  <a class="gh" href={REPO}>github ↗</a>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    height: var(--bar-h);
    padding: 0 var(--pad-x);
    border-bottom: 1px solid var(--line2);
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    min-width: 0;
    color: var(--hi);
    font-weight: 700;
    white-space: nowrap;
  }
  .brand:hover {
    color: var(--hi);
    background: none;
  }
  .brand-ver {
    color: var(--dim);
    font-size: 12.5px;
    font-weight: 400;
  }

  .tabs {
    position: relative;
    display: flex;
    gap: 2px;
    padding: 3px;
    overflow-x: auto;
    border: 1px solid var(--line2);
    border-radius: 10px;
    background: #111313;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar {
    display: none;
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 30px;
    padding: 0 12px;
    border-radius: 7px;
    color: var(--text2);
    font-weight: 500;
    white-space: nowrap;
    transition:
      background 0.18s ease,
      color 0.18s ease;
  }
  .tab-key {
    color: var(--dim);
    transition: color 0.18s ease;
  }
  .tab:hover {
    color: var(--text);
    background: var(--line2);
  }
  .tab.is-on {
    color: var(--on-cyan);
    background: var(--cyan);
    font-weight: 600;
  }
  .tab.is-on .tab-key {
    color: color-mix(in oklab, var(--on-cyan) 60%, var(--cyan));
  }

  .gh {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    height: 32px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: var(--r-inner);
    color: var(--text);
    white-space: nowrap;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .gh:hover {
    border-color: var(--cyan);
    color: var(--cyan);
    background: none;
  }

  @media (max-width: 760px) {
    .topbar {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 10px;
    }
    .brand-name,
    .brand-ver,
    .gh {
      display: none;
    }
    .tabs {
      justify-self: start;
      max-width: 100%;
    }
    .tab {
      padding: 0 10px;
    }
  }
</style>

<script>
  // Scrollspy, smooth section jumps, and the TUI-style keyboard shortcuts.
  // The active section id is mirrored to <html data-section> so other
  // components (Features' arrow keys) can scope their own shortcuts.
  const bar = document.querySelector<HTMLElement>('[data-topbar]');
  const strip = document.querySelector<HTMLElement>('[data-tabs]');
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
  const ids = tabs.map((t) => t.dataset.tab ?? '');
  const sections = ids.map((id) => document.getElementById(id));
  const repo = bar?.dataset.repo ?? '';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  let active = -1;
  let lockUntil = 0;
  let unlockTimer: ReturnType<typeof setTimeout> | undefined;
  let raf = 0;

  function setActive(i: number) {
    if (i === active) return;
    active = i;
    tabs.forEach((t, j) => {
      t.classList.toggle('is-on', j === i);
      if (j === i) t.setAttribute('aria-current', 'location');
      else t.removeAttribute('aria-current');
    });
    sections.forEach((s, j) => s?.classList.toggle('is-current', j === i));
    document.documentElement.dataset.section = ids[i];

    // On narrow screens the strip scrolls sideways; keep the active tab in view.
    const tab = tabs[i];
    if (strip && tab && strip.scrollWidth > strip.clientWidth) {
      const left = tab.offsetLeft - (strip.clientWidth - tab.offsetWidth) / 2;
      strip.scrollTo({ left, behavior: reduced.matches ? 'auto' : 'smooth' });
    }
  }

  function barHeight() {
    return bar?.offsetHeight ?? 52;
  }

  function spy() {
    if (Date.now() < lockUntil) return;
    const line = barHeight() + window.innerHeight * 0.3;
    let a = 0;
    sections.forEach((s, i) => {
      if (s && s.getBoundingClientRect().top <= line) a = i;
    });
    const doc = document.documentElement;
    if (window.innerHeight + window.scrollY >= doc.scrollHeight - 4) a = sections.length - 1;
    setActive(a);
  }

  // Scroll a section under the sticky bar. The highlight is set immediately and
  // the spy is paused until the smooth scroll settles, so tabs don't flicker
  // through every section on the way.
  function go(i: number) {
    const el = sections[i];
    if (!el) return;
    const top = i === 0 ? 0 : el.getBoundingClientRect().top + window.scrollY - barHeight() - 16;
    lockUntil = Date.now() + 700;
    setActive(i);
    history.replaceState(null, '', `#${ids[i]}`);
    window.scrollTo({ top, behavior: reduced.matches ? 'auto' : 'smooth' });
    clearTimeout(unlockTimer);
    unlockTimer = setTimeout(() => {
      lockUntil = 0;
      spy();
    }, 720);
  }

  document.querySelectorAll<HTMLElement>('[data-go]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      go(Number(el.dataset.go));
    });
  });

  function onScroll() {
    if (raf) return;
    raf = requestAnimationFrame(() => {
      raf = 0;
      spy();
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  spy();

  window.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || e.defaultPrevented) return;
    const target = e.target as HTMLElement | null;
    if (target?.closest('input, textarea, select, [contenteditable="true"]')) return;
    if (e.key >= '1' && e.key <= String(sections.length)) {
      e.preventDefault();
      go(Number(e.key) - 1);
    } else if (e.key === 'i') {
      go(ids.indexOf('install'));
    } else if (e.key === 'g') {
      window.open(repo, '_blank', 'noopener');
    } else if (e.key === 'd') {
      window.open(`${repo}/blob/main/README.md`, '_blank', 'noopener');
    }
  });
</script>
