---
// A recreation of `next-socks5 serve --mock`. Numbers are synthetic, like the
// mock mode itself; the throughput, trend and uptime tick live in the browser.

// Deterministic starting series so the server-rendered chart is stable.
function series(seed: number, start: number, min: number, max: number, step: number) {
  let s = seed;
  const rand = () => {
    s = (s * 16807) % 2147483647;
    return s / 2147483647;
  };
  const out: number[] = [];
  let v = start;
  for (let i = 0; i < 40; i++) {
    v = Math.min(max, Math.max(min, v + (rand() - 0.5) * step));
    out.push(Number(v.toFixed(3)));
  }
  return out;
}
const up = series(7, 0.45, 0.2, 0.95, 0.18);
const down = series(42, 1.6, 0.9, 2.2, 0.3);
const points = (arr: number[]) =>
  arr.map((v, i) => `${((i * 400) / (arr.length - 1)).toFixed(1)},${(100 - (v / 2.5) * 100).toFixed(1)}`).join(' ');
const pad = (n: number) => n.toFixed(1).padStart(7, ' ');

const conns = [
  ['14', '10.0.42.13:54012', 'example.com:443', 'CONNECT', '3.40 MB', '82.11 MB', '2m'],
  ['15', '10.0.118.7:51199', 'github.com:443', 'CONNECT', '1.20 MB', '44.50 MB', '1m'],
  ['16', '10.0.7.221:60233', 'api.ipify.org:443', 'CONNECT', '64.00 KB', '12.30 KB', '58s'],
  ['17', '10.0.201.5:49888', 'cdn.example.net:80', 'UDP', '220.00 KB', '5.10 MB', '47s'],
  ['18', '10.0.66.90:52741', 'speed.example.com:443', 'CONNECT', '8.90 MB', '402.50 MB', '41s'],
  ['19', '10.0.5.34:55010', 'db.internal:5432', 'CONNECT', '120.00 KB', '640.00 KB', '12s'],
  ['20', '10.0.150.2:58820', 'example.com:443', 'UDP', '44.00 KB', '18.70 KB', '4s'],
];
const SELECTED = 4;

const logs: [string, string][] = [
  ['mock data generator running', 'dim'],
  ['[#14] CONNECT open 10.0.42.13:54012 -> example.com:443', ''],
  ["auth ok for 'alice'", 'cy'],
  ['[#11] CONNECT closed 10.0.9.2:50122 -> github.com:443', 'dim'],
  ["auth failed (denied) for 'bob'", 'ye'],
  ['[#15] CONNECT open 10.0.118.7:51199 -> github.com:443', ''],
  ['error 0x05: connection refused', 'rd'],
  ['[#17] UDP open 10.0.201.5:49888 -> cdn.example.net:80', ''],
  ['error 0x03: network unreachable', 'rd'],
  ['[#18] CONNECT open 10.0.66.90:52741 -> speed.example.com:443', ''],
  ["auth ok for 'carol'", 'cy'],
];

const UPTIME = 14 * 60 + 32;
---

<section id="dashboard" class="section">
  <div class="section-head">
    <span class="section-key">2</span>
    <h2>Dashboard</h2>
    <span class="section-rule"></span>
  </div>
  <p class="section-lede">
    The same ratatui view ships in the binary. Run it in the foreground, preview it with
    <code>--mock</code>, or <code>attach</code> to a headless service over a local socket.
  </p>

  <div
    class="section-body box box--focus dash"
    data-dash
    data-up={JSON.stringify(up)}
    data-down={JSON.stringify(down)}
    data-uptime={UPTIME}
  >
    <span class="box-title">next-socks5 serve --mock</span>
    <span class="box-meta">up <span data-uptime-text>0:14:32</span> · active 7</span>
    <div class="dash-inner">
      <div class="grid-top">
        <div class="box box--inner">
          <span class="box-title">Throughput</span>
          <div class="pre">Up:   <span class="ye" data-up-now>{pad(245.3)}</span> KB/s  total <span class="dim">1.82 GB</span></div>
          <div class="pre">Down: <span class="cy" data-down-now>{pad(1788.5)}</span> KB/s  total <span class="dim">14.21 GB</span></div>
          <div class="pre dim">peak ↑512 ↓2048 KB/s</div>
          <div class="pre gap">conns total=1283 ok=<span class="cy">1271</span> fail=<span class="rd">12</span> (99.1%)</div>
          <div class="pre"><span class="ye">0x05 connrefused=5</span>  <span class="ye">0x04 hostunreach=3</span></div>
        </div>
        <div class="box box--inner">
          <span class="box-title">Trend (30s)</span>
          <svg class="trend" viewBox="0 0 400 100" preserveAspectRatio="none" aria-hidden="true">
            <line x1="0" y1="50" x2="400" y2="50" class="trend-mid" vector-effect="non-scaling-stroke"></line>
            <polyline points={points(down)} class="trend-down" data-down-line vector-effect="non-scaling-stroke"></polyline>
            <polyline points={points(up)} class="trend-up" data-up-line vector-effect="non-scaling-stroke"></polyline>
          </svg>
        </div>
      </div>

      <div class="grid-bottom">
        <div class="box box--inner scroll-x">
          <span class="box-title">Active connections (7)  sort:ID</span>
          <table class="conns">
            <thead>
              <tr>
                <th>ID</th><th>Source</th><th>Target</th><th>Kind</th>
                <th class="r">Up</th><th class="r">Down</th><th class="r">Age</th>
              </tr>
            </thead>
            <tbody>
              {
                conns.map((c, i) => (
                  <tr class:list={{ 'is-sel': i === SELECTED }}>
                    <td>{c[0]}</td>
                    <td>{c[1]}</td>
                    <td class="hi">{c[2]}</td>
                    <td class={c[3] === 'UDP' ? 'ye' : 'cy'}>{c[3]}</td>
                    <td class="r">{c[4]}</td>
                    <td class="r">{c[5]}</td>
                    <td class="r dim">{c[6]}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <div class="box box--inner">
          <span class="box-title">Log (1283)</span>
          <div class="log">
            {logs.map(([text, tone]) => <div class={tone || undefined}>{text}</div>)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dash {
    font-size: 12.5px;
    line-height: 1.62;
  }
  .dash-inner {
    display: flex;
    flex-direction: column;
    gap: var(--gap-in);
    padding-top: 6px;
  }
  .grid-top,
  .grid-bottom {
    display: grid;
    gap: var(--gap-in);
  }
  .grid-top {
    grid-template-columns: minmax(0, 40fr) minmax(0, 60fr);
  }
  .grid-bottom {
    grid-template-columns: minmax(0, 62fr) minmax(0, 38fr);
  }

  .pre {
    white-space: pre;
  }
  .gap {
    margin-top: 8px;
  }

  .trend {
    display: block;
    width: 100%;
    height: 118px;
  }
  .trend polyline {
    fill: none;
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .trend-mid {
    stroke: var(--line2);
    stroke-dasharray: 2 5;
  }
  .trend-down {
    stroke: var(--cyan);
  }
  .trend-up {
    stroke: var(--yellow);
  }

  .conns {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    white-space: nowrap;
  }
  .conns th {
    padding: 0 12px 6px 6px;
    color: var(--hi);
    font-weight: 700;
    text-align: left;
  }
  .conns td {
    padding: 1px 12px 1px 6px;
    color: var(--text2);
  }
  .conns td.hi {
    color: var(--hi);
  }
  .conns td.cy {
    color: var(--cyan);
  }
  .conns td.ye {
    color: var(--yellow);
  }
  .conns td.dim {
    color: var(--dim);
  }
  .conns .r {
    text-align: right;
  }
  .conns tr.is-sel td {
    background: var(--line2);
    color: var(--text);
  }
  .conns tr.is-sel td:first-child {
    border-radius: 5px 0 0 5px;
  }
  .conns tr.is-sel td:last-child {
    border-radius: 0 5px 5px 0;
  }

  .log {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: var(--text2);
    white-space: nowrap;
  }

  @media (max-width: 960px) {
    .grid-top,
    .grid-bottom {
      grid-template-columns: minmax(0, 1fr);
    }
    .scroll-x {
      overflow-x: auto;
    }
  }
</style>

<script>
  // Keep the mock dashboard ticking like the real one: a random walk for
  // throughput, the trend lines, and the uptime counter. Paused off-screen and
  // disabled entirely under reduced motion.
  const dash = document.querySelector<HTMLElement>('[data-dash]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (dash && !reduced) {
    const up: number[] = JSON.parse(dash.dataset.up ?? '[]');
    const down: number[] = JSON.parse(dash.dataset.down ?? '[]');
    let uptime = Number(dash.dataset.uptime ?? 0);

    const upNow = dash.querySelector('[data-up-now]');
    const downNow = dash.querySelector('[data-down-now]');
    const upLine = dash.querySelector('[data-up-line]');
    const downLine = dash.querySelector('[data-down-line]');
    const uptimeText = dash.querySelector('[data-uptime-text]');

    const walk = (arr: number[], min: number, max: number, step: number) => {
      const last = arr[arr.length - 1] ?? (min + max) / 2;
      arr.shift();
      arr.push(Math.min(max, Math.max(min, last + (Math.random() - 0.5) * step)));
    };
    const points = (arr: number[]) =>
      arr.map((v, i) => `${((i * 400) / (arr.length - 1)).toFixed(1)},${(100 - (v / 2.5) * 100).toFixed(1)}`).join(' ');
    const pad = (n: number) => n.toFixed(1).padStart(7, ' ');
    const clock = (t: number) =>
      `${Math.floor(t / 3600)}:${String(Math.floor((t % 3600) / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}`;

    const tick = () => {
      walk(up, 0.2, 0.95, 0.18);
      walk(down, 0.9, 2.2, 0.3);
      uptime += 1;
      if (upNow) upNow.textContent = pad(up[up.length - 1] * 512);
      if (downNow) downNow.textContent = pad(down[down.length - 1] * 1024);
      upLine?.setAttribute('points', points(up));
      downLine?.setAttribute('points', points(down));
      if (uptimeText) uptimeText.textContent = clock(uptime);
    };

    let timer: ReturnType<typeof setInterval> | undefined;
    new IntersectionObserver(([entry]) => {
      clearInterval(timer);
      if (entry?.isIntersecting) timer = setInterval(tick, 1000);
    }).observe(dash);
  }
</script>
