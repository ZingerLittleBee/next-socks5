---
import { REPO } from '../consts';

// Headline numbers from docs/PERFORMANCE.md (4-core cloud VM, loopback).
const nums = [
  { value: '~2 GB/s', label: 'relay throughput' },
  { value: '~1.6 ms', label: 'added latency' },
  { value: '~6k/s', label: 'new connections' },
];
---

<section id="perf" class="section">
  <div class="section-head">
    <span class="section-key">4</span>
    <h2>Perf</h2>
    <span class="section-rule"></span>
  </div>
  <p class="section-lede">
    Measured on a single 4-core cloud VM over loopback. The kernel saturates before the proxy does.
  </p>

  <div class="section-body box">
    <span class="box-title">bench · 4-core VM · loopback</span>
    <div class="perf">
      <div class="nums">
        {
          nums.map((n) => (
            <div class="num">
              <strong>{n.value}</strong>
              <span>{n.label}</span>
            </div>
          ))
        }
      </div>
      <div class="bars">
        <div class="bar">
          <span>kernel TCP stack</span>
          <div class="meter" aria-hidden="true"><i style="width:96%"></i></div>
          <span class="cy">saturated</span>
        </div>
        <div class="bar">
          <span>proxy lock waits</span>
          <div class="meter" aria-hidden="true"><i style="width:0%"></i></div>
          <span class="dim">none</span>
        </div>
        <p class="hint">
          Harness and caveats: <a href={`${REPO}/blob/main/docs/PERFORMANCE.md`}>docs/PERFORMANCE.md</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .perf {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: 40px;
  }

  .nums {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .num {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .num strong {
    color: var(--hi);
    font-size: clamp(30px, 3.4vw, 48px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  .num span {
    color: var(--dim);
    font-size: 12.5px;
  }

  .bars {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .bar {
    display: grid;
    grid-template-columns: 18ch minmax(0, 1fr) 9ch;
    align-items: center;
    gap: 12px;
    color: var(--text2);
    font-size: 12.5px;
  }
  .meter {
    height: 10px;
    overflow: hidden;
    border-radius: 3px;
    background: repeating-linear-gradient(90deg, var(--line2) 0 6px, transparent 6px 8px);
  }
  .meter i {
    display: block;
    height: 100%;
    background: repeating-linear-gradient(90deg, var(--cyan) 0 6px, transparent 6px 8px);
  }
  .bars .hint {
    margin: 6px 0 0;
  }

  @media (max-width: 960px) {
    .perf,
    .nums,
    .bar {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
