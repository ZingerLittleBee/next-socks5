---
import { REPO, SECTIONS } from '../consts';
---

<footer class="statusbar">
  <span><b>1-{SECTIONS.length}</b> jump</span>
  <span><b>↑↓</b> select</span>
  <span><b>i</b> install</span>
  <span><b>g</b> github</span>
  <span><b>q</b> quit (you can't, it's a website)</span>
  <span class="links">
    MIT · <a href={`${REPO}/releases`}>releases</a> · <a href={`${REPO}/blob/main/LICENSE`}>license</a>
  </span>
</footer>

<style>
  .statusbar {
    position: sticky;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    padding: 5px 14px;
    border-top: 1px solid var(--line);
    background: #151818;
    color: var(--dim);
    font-size: 12.5px;
    white-space: nowrap;
  }
  b {
    color: var(--cyan);
    font-weight: 600;
  }
  .links {
    margin-left: auto;
  }
</style>
