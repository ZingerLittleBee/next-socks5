---
import { REPO, SECTIONS } from '../consts';

const installIdx = SECTIONS.findIndex((s) => s.id === 'install');
---

<section id="overview" class="section">
  <div class="box box--double hero">
    <span class="box-title">README.md</span>
    <div class="dim"># SOCKS5 server · RFC 1928 + RFC 1929 · written in Rust</div>
    <h1>A SOCKS5 proxy that <span class="cy">shows its work.</span></h1>
    <p class="lede">
      This page is drawn the way the server's dashboard is: panels, keys, and a log you can read. A
      hand-written protocol core with secure defaults, one-command install, and every connection on
      screen.
    </p>
    <div class="keys">
      <a class="key key--primary" href="#install" data-go={installIdx}><kbd>i</kbd>install</a>
      <a class="key" href={REPO}><kbd>g</kbd>github</a>
      <a class="key" href={`${REPO}/blob/main/README.md`}><kbd>d</kbd>docs</a>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 980px;
    margin-inline: auto;
    padding: clamp(36px, 5vw, 64px) clamp(20px, 4vw, 48px);
    text-align: center;
  }

  h1 {
    margin: 18px 0 0;
    color: var(--hi);
    font-size: clamp(36px, 5.2vw, 72px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .lede {
    max-width: 60ch;
    margin: 24px 0 0;
    color: var(--text2);
    text-wrap: balance;
  }

  .keys {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 32px;
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 42px;
    padding: 0 14px 0 5px;
    border: 1px solid var(--line);
    border-radius: var(--r-inner);
    color: var(--text);
    transition:
      border-color 0.12s ease,
      background 0.12s ease;
  }
  .key:hover {
    border-color: var(--cyan);
    background: var(--line2);
    color: var(--text);
  }
  .key kbd {
    display: inline-grid;
    place-items: center;
    min-width: 42px;
    height: 28px;
    padding: 0 6px;
    border-radius: 5px;
    background: var(--line2);
    color: var(--cyan);
    font-size: 13px;
    font-weight: 600;
  }
  .key--primary,
  .key--primary:hover {
    border-color: var(--cyan);
    color: var(--on-cyan);
    font-weight: 600;
  }
  .key--primary {
    background: var(--cyan);
  }
  .key--primary:hover {
    background: oklch(0.86 0.1 195);
  }
  .key--primary kbd {
    background: var(--on-cyan);
    color: var(--cyan);
  }
</style>
